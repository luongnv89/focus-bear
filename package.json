{
  "name": "focus-bear",
  "version": "0.1.0",
  "description": "FocusBear - Privacy-first Chrome extension for tracking focus-switching habits",
  "type": "module",
  "scripts": {
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,html,css}\"",
    "test": "jest",
    "build": "node scripts/build.js",
    "dev": "node scripts/watch.js"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "eslint": "^8.52.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.0.3"
  },
  "dependencies": {
    "d3": "^7.8.5"
  },
  "keywords": [
    "productivity",
    "focus",
    "chrome-extension",
    "tracking",
    "privacy"
  ],
  "author": "",
  "license": "MIT"
}
