# FocusBear Landing Page Environment Variables
# Copy this file to .env.local and fill in actual values

# Chrome Web Store URL for the extension (required)
VITE_CHROME_STORE_URL=https://chrome.google.com/webstore/detail/focusbear/your-extension-id

# App version (optional, defaults to package.json version)
VITE_APP_VERSION=0.2.0

# GitHub repository URL
VITE_GITHUB_URL=https://github.com/luongnv89/focus-bear
