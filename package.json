{
  "name": "focus-bear",
  "version": "0.1.0",
  "description": "FocusBear - Privacy-first Chrome extension for tracking focus-switching habits",
  "type": "module",
  "scripts": {
    "lint": "npm run format:check && eslint \"src/**/*.js\"",
    "lint:fix": "prettier --write \"src/**/*.{js,html,css}\" && eslint \"src/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.{js,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,html,css}\"",
    "test": "jest",
    "version:update": "bash scripts/update-version.sh",
    "icons:generate": "node scripts/generate-icons.js",
    "build": "npm run version:update && node scripts/build.js",
    "dev": "node scripts/watch.js",
    "prepare": "husky install",
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "src/**/*.{html,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "eslint": "^8.52.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15.0.2",
    "prettier": "^3.0.3",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "d3": "^7.8.5"
  },
  "keywords": [
    "productivity",
    "focus",
    "chrome-extension",
    "tracking",
    "privacy"
  ],
  "author": "",
  "license": "MIT"
}
